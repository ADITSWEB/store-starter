---
import PageLayout from "@/layouts/PageLayout.astro";

import ProductGrid from "./_components/view/ProductGrid.astro";
import ProductList from "./_components/view/ProductList.astro";
import ProductToolbar from "./_components/toolbar/ProductToolbar.astro";

import { ProductService } from "@/backend/ProductService";

const basePath = import.meta.env.APP_BASE_PATH;
const products = await ProductService.getAll();
---

<PageLayout
  title="Products"
  description="Browse our complete catalogue."
  breadcrumbs={[
    { label: "Home", href: basePath },
    { label: "Products" }
  ]}
  xdata="productsView"
>

  <ProductToolbar />

  <div x-show="view === 'grid'" x-cloak>
    <ProductGrid products={products} />
  </div>

  <div x-show="view === 'list'" x-cloak>
    <ProductList products={products} />
  </div>

</PageLayout>
