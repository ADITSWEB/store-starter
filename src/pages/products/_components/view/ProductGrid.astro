---

import ProductCard from "../../../../components/product/ProductCard.astro";
import EmptyState from "../../../../components/store/EmptyState.astro";

import type { Product } from "@/types/product";

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

{
products.length === 0 ? (
  <EmptyState
      title="No products found."
      description="Please check back later."
  />
) : (
  <div class="grid gap-6 grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5">
      {products.map(product => (
        <ProductCard product={product} preset="grid"/>
      ))}
  </div>
)}