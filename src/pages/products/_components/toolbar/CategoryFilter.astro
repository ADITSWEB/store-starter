---
import CategoryChip from "@/components/category/CategoryChip.astro";
import type { Category } from "@/types/category";

interface Props {
  categories: Category[];
  selectedId?: string;
}

const {
  categories,
  selectedId
} = Astro.props;
---

<div class="mb-8 flex flex-wrap gap-3">

<CategoryChip
    category="All"
    selected={!selectedId}
/>

{
categories.map(category => (

<CategoryChip
    category={category.name}
    selected={selectedId===category.id}
/>

))
}

</div>