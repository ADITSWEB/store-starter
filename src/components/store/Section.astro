---
interface Props {
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  actions?: boolean;
}

const {
  title,
  subtitle,
  align = "left"
} = Astro.props;
---

<section class="py-16">
  <div class="container mx-auto px-4">

    <header
  class:list={[
    "mb-10 flex items-end justify-between gap-4",
    align === "center" && "flex-col text-center items-center"
  ]}
>

  <div>

    <h2 class="font-heading text-3xl font-semibold">
      {title}
    </h2>

    {
      subtitle &&
      <p class="mt-2 text-muted-foreground">
        {subtitle}
      </p>
    }

  </div>

  <slot name="actions" />

</header>

<slot />


  </div>
</section>