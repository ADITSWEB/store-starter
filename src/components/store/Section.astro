---
interface Props {
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  actions?: boolean;
  class?: string;
}

const {
  title,
  subtitle,
  align = "left"
} = Astro.props;
---

<section class:list={["py-16", Astro.props.class]}>
  <div class="mx-auto w-full min-w-0 max-w-7xl px-4">
    <header
      class:list={[
        "mb-10 flex min-w-0 items-end justify-between gap-4",
        align === "center" && "flex-col items-center text-center"
      ]}
    >
      <div class="min-w-0">
        <h2 class="font-heading text-3xl font-semibold">
          {title}
        </h2>

        {
          subtitle &&
          <p class="mt-2 text-muted-foreground">
            {subtitle}
          </p>
        }
      </div>

      <slot name="actions" />
    </header>

    <div class="min-w-0">
      <slot />
    </div>
  </div>
</section>