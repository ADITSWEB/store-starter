---
import {
  Card,
  CardContent,
  CardFooter,
} from "@/components/ui/card";

import { Button } from "@/components/ui/button";

import type { Product } from "@/types/product";

import { formatPrice } from "@/lib/helpers";

interface Props {
  product: Product;
}

const { product } = Astro.props;

const image =  product.images?.[0]?.url ??
   "/store-starter/images/product-placeholder.jpg";
---

<Card
  class="group gap-0 py-0 overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-md"
>

  <div class="aspect-square w-full min-w-0 overflow-hidden bg-surface">

    <img
      src={image}
      alt={product.name}
      class="size-full object-cover transition duration-300 group-hover:scale-105"
    />

  </div>

  <CardContent class="space-y-3 p-6">

    {
      product.badge && (
        <span
          class="inline-flex rounded-full bg-accent px-3 py-1 text-xs font-medium text-white"
        >
          {product.badge}
        </span>
      )
    }

    <h3 class="line-clamp-2 font-heading text-lg font-semibold">
      {product.name}
    </h3>

    <p class="text-primary text-xl font-semibold">
      {formatPrice(product.price)}
    </p>

  </CardContent>

  <CardFooter class="pt-0">

    <Button
      class="w-full"
      variant="default"
    >
      View Details
    </Button>

  </CardFooter>

</Card>