---
import Container from "./Container.astro";
import { Button } from "./ui/button";
import { StoreService } from "@/backend/StoreService";

const store = await StoreService.getStore();
const heroImage = store.hero?.url ?? '#';
const basePath = import.meta.env.APP_BASE_PATH;
---

<section class="py-16">

  <Container>

    <div class="grid items-center gap-10 lg:grid-cols-2">

      <div>

        <h1 class="mb-6 text-5xl font-bold leading-tight">
          {store.tagline}
        </h1>

        <p class="mb-8 text-lg text-gray-600">
          {store.description}
        </p>

        <div class="flex flex-wrap gap-4">

          <Button>
          <a
            href={basePath + "/products"}
          >
            Browse Products
          </a></Button>

          <Button variant="outline">

          <a
            href={store.whatsapp}
            target="_blank"
          >
            Contact on WhatsApp
          </a>
          </Button>

        </div>

      </div>

      <div>

        <img
          src={heroImage}
          alt={store.name}
          class="w-full rounded-3xl shadow-xl"
        />

      </div>

    </div>

  </Container>

</section>