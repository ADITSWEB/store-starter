---
import Container from "./Container.astro";
import { Image } from 'astro:assets';
import { Button } from "./ui/button";
import { StoreService } from "@/backend/StoreService";

const store = await StoreService.getStore();
const basePath = import.meta.env.APP_BASE_PATH;
const logoImage = store.logo?.url ?? '#';
---

<header class="border-b bg-white">
  <Container class="flex items-center justify-between py-4">

    <a href={basePath} class="flex items-center gap-3">
        <Image
          src={logoImage}
          width={100}
          height={100}
          alt={store.logo?.alt ?? store.name}
          class="h-10 w-10 rounded-full"
        />

      <span class="text-xl font-semibold">
        {store.name}
      </span>
    </a>


    <Button>
      <a
      href={store.whatsapp}
      target="_blank">
        WhatsApp
      </a>
    </Button>

  </Container>
</header>