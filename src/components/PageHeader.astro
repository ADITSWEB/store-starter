---
import Breadcrumbs from "./Breadcrumbs.astro";

const {
  title,
  description,
  breadcrumbs = []
} = Astro.props;
---

<header class="mb-10">

  <Breadcrumbs breadcrumbs={breadcrumbs} />

  <h1 class="font-heading text-4xl font-semibold">
    {title}
  </h1>

  {description && (
    <p class="mt-3 text-muted-foreground">
      {description}
    </p>
  )}

</header>