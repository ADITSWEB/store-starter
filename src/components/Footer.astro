---
import { StoreService } from "@/backend/StoreService";
import {
  Mail,
  MessageCircle,
  MapPin
} from "@lucide/astro";
// import { Icon } from 'astro-icon/components'
const store = await StoreService.getStore();

---

<footer class="border-t bg-surface mt-20">
  <div class="mx-auto w-full min-w-0 max-w-7xl px-4 py-12">

    <div class="grid gap-10 md:grid-cols-3">

      <!-- Brand -->

      <section>

        <h3 class="font-heading text-2xl font-semibold">
          {store.name}
        </h3>

        <p class="mt-3 text-muted-foreground max-w-sm">
          {store.tagline}
          Browse our catalogue and order directly on WhatsApp.
        </p>

      </section>

      <!-- Quick Links -->

      <section>

        <h4 class="font-semibold mb-4">
          Quick Links
        </h4>

        <nav class="flex flex-col gap-2 text-sm">

          <a href="/">Home</a>

          <a href="/products">Products</a>

          <a href="/contact">Contact</a>

        </nav>

      </section>

      <!-- Contact -->

      <section>

        <h4 class="font-semibold mb-4">
          Contact
        </h4>

        <div class="space-y-3 text-sm">

          <a
            href={store.whatsapp}
            class="flex items-center gap-3 hover:text-primary"
          >
            <MessageCircle size={18}/>
            WhatsApp
          </a>

          <a
            href="mailto:hello@example.com"
            class="flex items-center gap-3 hover:text-primary"
          >
            <Mail size={18}/>
            {store.email}
          </a>

          <div class="flex items-center gap-3">
            <MapPin size={18}/>
            {store.city}
          </div>

          <a
            href={store.instagram}
            class="flex items-center gap-3 hover:text-primary pl-8"
          >
            <!-- <Instagram size={18}/> -->
            <!-- <Icon name="mdi:home" /> -->
            Instagram
          </a>

        </div>

      </section>

    </div>

    <div class="mt-10 border-t pt-6 text-center text-xs text-muted-foreground">

      © 2026 {store.name} • By ADITS Web Technologies

    </div>

  </div>
</footer>