---
import ProductCard from "../store/ProductCard.astro";
import { Card } from "../ui/card";
import Section from "../store/Section.astro";
import { ProductService } from "@/backend/ProductService";

const featuredProducts = await ProductService.getFeatured();
---

    <Section
    title="Featured Products"
    subtitle="Discover our latest handcrafted creations."
     >
    <div
        class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4"
    >
    {featuredProducts.length > 0 ?
        featuredProducts.map(product => (
            <ProductCard product={product}  />
        )) :
        <Card class="p-8 text-center">
            <p class="text-muted-foreground">
                New products coming soon.
            </p>
        </Card>
    }
    </div>
</Section>