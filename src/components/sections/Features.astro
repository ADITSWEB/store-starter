---
import ProductCard from "../store/ProductCard.astro";
import { Card } from "../ui/card";
import Section from "../store/Section.astro";
import { ProductService } from "@/backend/ProductService";

const featuredProducts = await ProductService.getFeatured();
---

    <Section
    title="Featured Products"
    subtitle="Discover our latest handcrafted creations."
    class="bg-linear-to-tr from-indigo-200 from-10% via-purple-200 via-40% to-pink-200 to-90%"
     >
    <!-- The purple middle point stays compressed between 40% and 60% -->

    <div
        class="grid w-full grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4"
    >
    {featuredProducts.length > 0 ?
        featuredProducts.map(product => (
            <ProductCard product={product}  />
        )) :
        <Card class="p-8 text-center">
            <p class="text-muted-foreground">
                New products coming soon.
            </p>
        </Card>
    }
    </div>
</Section>