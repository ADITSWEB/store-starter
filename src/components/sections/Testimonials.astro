---
import Section from "../store/Section.astro";

import {
    Card,
    CardContent
} from "@/components/ui/card";

import { testimonials } from "@/data/testimonials";
---

<Section
    title="What Our Customers Say"
    subtitle="Kind words from happy customers."
>

    <div class="grid gap-6 md:grid-cols-3">

        {
            testimonials.map((testimonial) => (
                <Card class="h-full">
                    <CardContent class="flex h-full flex-col p-6">
                        <div class="mb-4 text-amber-400 text-lg">
                            {"★".repeat(testimonial.rating)}
                        </div>

                        <p class="mb-6 grow text-muted-foreground italic">
                            "{testimonial.comment}"
                        </p>
                        <div>
                            <p class="font-semibold">
                                {testimonial.name}
                            </p>
                            <p class="text-sm text-muted-foreground">
                                {testimonial.location}
                            </p>
                        </div>
                    </CardContent>
                </Card>
            ))
        }
    </div>
</Section>